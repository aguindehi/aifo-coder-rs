{
    "$schema": "https://opencode.ai/config.json",
    "model": "azure/gpt-5.1",
    "small_model": "azure/gpt-5-mini",
    "provider": {
        "azure": {
            "options": {
                "baseURL": "https://mgb-aifo-proxy.service.migros.cloud/aoai/openai",
                "apiKey": "{env:AIFO_API_KEY}"
            }
        }
    },
    "watcher": {
        "ignore": ["node_modules/**", ".*/**", "build/**"]
    },
    "agent": {
        "build": {
            "mode": "primary",
            "tools": {
                "write": true,
                "edit": true,
                "bash": true
            }
        },
        "plan": {
            "mode": "primary",
            "tools": {
                "write": false,
                "edit": false,
                "bash": false
            }
        },
        "code-reviewer": {
            "description": "Reviews code for best practices and potential issues",
            "mode": "subagent",
            "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
            "tools": {
                "write": false,
                "edit": false
            }
        }
    }
}
